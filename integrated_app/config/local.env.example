# Copy to local.env and fill secrets locally. Never commit local.env.
APP_PORT=8769
APP_DATA_DIR=runtime
APP_SECRET_KEY=
DATABASE_MODE=neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
ENABLE_PAID_PIPELINE=0
API_MAX_COST_YUAN=3
API_MAX_REQUESTS=100
MAX_PDF_PAGES=35
